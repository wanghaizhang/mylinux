#
# MyLinux BusyBox config (minimal server)
#
# Regenerate with: make busybox-menuconfig
#

CONFIG_FEATURE_INSTALL_ALL=y
CONFIG_FEATURE_SH_STANDALONE=y
CONFIG_FEATURE_SH_MATH=y

# Applets
CONFIG_ASH=y
CONFIG_FEATURE_ASH_OPTPARSE=y
CONFIG_FEATURE_ASH_TEST=y
CONFIG_BUSYBOX=y
CONFIG_FEATURE_BUSYBOX_SUGGY=y
CONFIG_FEATURE_NEVERDUMP=y
CONFIG_FEATURE_PREFER_APPLETS=y
CONFIG_FEATURE_SHOW_ALL=y
CONFIG_FEATURE_VERBOSE=y
CONFIG_FEATURE_WHO_IS_HANGING_UP=y

# Networking applets
CONFIG_FEATURE_NETWORKING_LONG_OPTIONS=y
CONFIG_FEATURE_NETWORKING_OPTION_VERBOSE=y
CONFIG_FEATURE_PING_IPV4=y
CONFIG_FEATURE_PING_IPV6=y
CONFIG_FEATURE_TC=y
CONFIG_FEATURE_TC_INGRESS=y

# Utilities
CONFIG_FEATURE_INSTALL_ALL=y
CONFIG_FEATURE_CLEAN_UP=y
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_EDITING_MAX_LEN=2048
CONFIG_FEATURE_EDITING_HISTORY=2048
CONFIG_FEATURE_EDITING_SAVEHISTORY=y
CONFIG_FEATURE_EDITING_TABS=y
CONFIG_FEATURE_EDITING_WISDOM=y
CONFIG_FEATURE_LS_FILETYPES=y
CONFIG_FEATURE_LS_FOLLOWSY=y
CONFIG_FEATURE_LS_RECURSIVE=y
CONFIG_FEATURE_LS_SORTFILES=y
CONFIG_FEATURE_LS_TIMESTAMPS=y
CONFIG_FEATURE_LS_USERNAME=y
CONFIG_FEATURE_MV_COMPLETION=y
CONFIG_FEATURE_PWD=y
CONFIG_FEATURE_TAR_CHOWN=y
CONFIG_FEATURE_TAR_LONG_OPTIONS=y
CONFIG_FEATURE_TAR_UNAME_GNAME=y
CONFIG_FEATURE_TAR_FROM=y

# Shells
CONFIG_ASH=y
CONFIG_FEATURE_ASH_ALIAS=y
CONFIG_FEATURE_ASH_ARITH=y
CONFIG_FEATURE_ASH_CFLAGS="-Os"
CONFIG_FEATURE_ASH_INTERNAL_G=y
CONFIG_FEATURE_ASH_OPTPARSE=y
CONFIG_FEATURE_ASH_TEST=y

# Coreutils
CONFIG_FEATURE_INSTALL_ALL=y
CONFIG_FEATURE_MOUNT_HELPERS=y
CONFIG_FEATURE_MOUNT_CIFS=y
CONFIG_FEATURE_MOUNT_FAT=y
CONFIG_FEATURE_MOUNT_NFS=y
CONFIG_FEATURE_MOUNT_NOFAIL=y
CONFIG_FEATURE_MOUNT_OTHER=y
CONFIG_FEATURE_MOUNT_OPTIONS=y
CONFIG_FEATURE_MOUNT_PERSISTENT=y
CONFIG_FEATURE_MOUNT_POINT=y
CONFIG_FEATURE_MOUNT_SOURCE=y
CONFIG_FEATURE_MOUNT_STATIC=y
CONFIG_FEATURE_MOUNT_STATIC_NFS=y
CONFIG_FEATURE_MOUNT_STATIC_NFS=y

# Init
CONFIG_FEATURE_INIT_MODPROBE=y
CONFIG_FEATURE_INIT_OPTIONAL=y
CONFIG_FEATURE_INIT_SCTTY=y
CONFIG_FEATURE_INIT_SYSLOG=y
CONFIG_FEATURE_INIT_VERBOSE=y
CONFIG_FEATURE_INIT_TTY=y
CONFIG_INIT=y
CONFIG_INIT_ENV_CHANGE=y
CONFIG_INIT_ENV_CHANGE_LIST=y

# Dropbear is a separate package; BusyBox provides sh, ifconfig, ip, etc.
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_EDITING_MAX_LEN=2048
CONFIG_FEATURE_EDITING_SAVEHISTORY=y
CONFIG_FEATURE_EDITING_TABS=y
CONFIG_FEATURE_EDITING_WISDOM=y
CONFIG_FEATURE_EDITING_HISTORY=2048
CONFIG_FEATURE_EDITING_HISTORY_FILE=y
CONFIG_FEATURE_EDITING_HISTORY_FILE=y
CONFIG_FEATURE_LS_FILETYPES=y
CONFIG_FEATURE_LS_FOLLOWSY=y
CONFIG_FEATURE_LS_RECURSIVE=y
CONFIG_FEATURE_LS_SORTFILES=y
CONFIG_FEATURE_LS_TIMESTAMPS=y
CONFIG_FEATURE_LS_USERNAME=y
CONFIG_FEATURE_PWD=y
CONFIG_FEATURE_TAR_CHOWN=y
CONFIG_FEATURE_TAR_LONG_OPTIONS=y
CONFIG_FEATURE_TAR_UNAME_GNAME=y
CONFIG_FEATURE_TAR_FROM=y
