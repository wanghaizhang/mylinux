# board/mylinux/linux.config
#
# MyLinux x86_64 minimal server kernel
#

# Architecture
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_X86=y
CONFIG_X86_64_DEFCONFIG=y

# General setup
CONFIG_INIT_ENV_ARG_LIMIT=32
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# Kernel features
CONFIG_EXPERT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_PREEMPT_NONE=y
CONFIG_HZ_250=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y

# Kernel printk / console
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=7
CONFIG_CONSOLE_LOGLEVEL_QUIET=7
CONFIG_DEFAULT_MESSAGE_LOGLEVEL=7

# CPU / TSC / APIC
CONFIG_X86_TSC=y
CONFIG_X86_TSC_ADJUST=y
CONFIG_X86_MCE=y
CONFIG_X86_MCE_INTEL=y
CONFIG_X86_MCE_AMD=y
CONFIG_X86_LOCAL_APIC=y
CONFIG_X86_IO_APIC=y
CONFIG_X86_X2APIC=y

# Clock / timers
CONFIG_HPET_TIMER=y
CONFIG_HPET=y
CONFIG_GENERIC_CLOCKEVENTS=y
CONFIG_GENERIC_CLOCKEVENTS_BROADCAST=y
CONFIG_GENERIC_CLOCKEVENTS_MIN_ADJUST=y

# ACPI
CONFIG_ACPI=y
CONFIG_ACPI_LEGACY_TABLES_LOOKUP=y
CONFIG_ACPI_SYSTEM_POWER_STATES_SUPPORT=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_PROCESSOR=y
CONFIG_ACPI_THERMAL=y
CONFIG_ACPI_PCI_SLOT=y

# PCI
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_MSI_ARCH_FALLBACKS=y

# VirtualBox / common virtual hardware
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y

# Block devices
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI=y
CONFIG_SCSI_LOWLEVEL=y
CONFIG_ATA=y
CONFIG_ATA_GENERIC=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y

# Filesystems
CONFIG_FILE_LOCKING=y
CONFIG_FS_POSIX_ACL=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# EFI / UEFI
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y

# GPT / partition support
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y

# Networking
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_PCNET32=y
CONFIG_NET_9P=y

# Loopback
CONFIG_NET_CORE=y

# Input
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y

# Serial console
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y

# Random
CONFIG_RANDOM_TRUST_CPU=y

# UNIX / sockets
CONFIG_UNIX=y

# SysV IPC
CONFIG_SYSVIPC=y

# Kernel modules
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# Kernel compression
CONFIG_KERNEL_GZIP=y

# Magic SysRq
CONFIG_MAGIC_SYSRQ=y

# Debugging / diagnostics
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO_NONE=y

# Security
CONFIG_SECURITY=y
CONFIG_DEFAULT_SECURITY_DAC=y

# Initramfs support
CONFIG_BLK_DEV_INITRD=y

# ELF binary support
CONFIG_BINFMT_ELF=y

# /dev
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
