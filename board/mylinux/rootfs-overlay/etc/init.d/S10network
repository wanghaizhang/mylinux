#!/bin/sh
#
# S10network - basic network bringup for MyServerOS (DHCP)
#

case "$1" in
  start)
    echo "Bringing up network via DHCP..."
    if ifconfig eth0 up 2>/dev/null; then
        udhcpc -i eth0 2>/dev/null || udhcpc 2>/dev/null || true
    fi
    ;;
  stop)
    ifconfig eth0 down 2>/dev/null || true
    ;;
  *)
    echo "Usage: $0 {start|stop}"
    exit 1
    ;;
esac

exit 0
