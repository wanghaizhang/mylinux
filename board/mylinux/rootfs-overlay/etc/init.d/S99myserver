#!/bin/sh
#
# S99myserver - startup script for MyServerOS
# Installed into the rootfs overlay at /etc/init.d/
#

. /etc/rc.func

case "$1" in
  start)
    echo "Starting MyServerOS services..."

    # Mount filesystems
    mount -a

    # Print network info
    echo "----- Network -----"
    ifconfig -a 2>/dev/null || ip -br addr 2>/dev/null

    # Start dropbear SSH if configured
    if [ -f /etc/dropbear/dropbear_rsa_host_key ]; then
        dropbear -F 2>/dev/null || true
    fi

    echo "MyServerOS is up. Login as root."
    ;;
  stop)
    echo "Stopping MyServerOS services..."
    ;;
  *)
    echo "Usage: $0 {start|stop}"
    exit 1
    ;;
esac

exit 0
