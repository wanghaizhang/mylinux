#
# MyLinux x86_64 defconfig (v0.1)
#
# Target architecture
#
# Target options
#
BR2_x86_64=y
BR2_x86_64_v1=y   # generic x86-64 baseline
BR2_NATIVE_WORDSIZE=y

#
# Toolchain
#
BR2_TOOLCHAIN_EXTERNAL=y
BR2_GCC_ENABLE_PTHREAD=y
BR2_TOOLCHAIN_EXTERNAL_GCC_13=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y
BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD_RETRY=5
BR2_TOOLCHAIN_EXTERNAL_URL="https://buildroot.org/downloads/toolchains/toolchains.x86_64.tar.xz"
BR2_TOOLCHAIN_EXTERNAL_CHECKSUM="6478d5c98fbe957e83a0006f10493919a6226986cfd5e74a9f68f69e0b89b5f0"
BR2_TOOLCHAIN_EXTERNAL_C_GLIBC=y
BR2_TOOLCHAIN_EXTERNAL_GLIBC_VERSION_2_38=y
BR2_TOOLCHAIN_EXTERNAL_GLIBC_SERIALIZATION=y
BR2_TOOLCHAIN_EXTERNAL_OPENSSL_3=y
BR2_TOOLCHAIN_EXTERNAL_OPENSSL_DEFAULT_CERT_PATHS=y
BR2_TOOLCHAIN_EXTERNAL_OPENSSL_ECDSA=y
BR2_TOOLCHAIN_EXTERNAL_OPENSSL_EDDSA=y
BR2_TOOLCHAIN_EXTERNAL_OPENSSL_RSA=y
BR2_TOOLCHAIN_EXTERNAL_OPENSSL_SM=y
BR2_TOOLCHAIN_EXTERNAL_OPENSSL_TLS1_1=y

#
# System configuration
#
BR2_SYSTEM_HOSTNAME="myserveros"
BR2_SYSTEM_BANNER="MyServerOS v0.1"
BR2_SYSTEM_DEFAULT_PATH="/usr/bin:/usr/sbin:/bin:/sbin"
BR2_SYSTEM_BIN_SH="/bin/sh"

#
# Init system: BusyBox init (no systemd)
#
BR2_INIT_BUSYBOX=y

#
# Kernel
#
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12"
BR2_LINUX_KERNEL_DEFCONFIG="generic"
BR2_LINUX_KERNEL_ZIMAGE=y
BR2_LINUX_KERNEL_APPEND_CONFIG_B=y

#
# Bootloaders
#
BR2_TARGET_GENERIC_REMAP=y

#
# Target packages
#
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG="board/mylinux/busybox.config"
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BUSYBOX_NETWORKING=y
BR2_PACKAGE_BUSYBOX_FEATURE_FEATURE_NETWORKING_LONG_OPTIONS=y

# Networking applications
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_DROPBEAR_ECC=y
BR2_PACKAGE_DROPBEAR_REGULAR=y
BR2_PACKAGE_DROPBEAR_CRYPT=y
BR2_PACKAGE_DROPBEAR_SCP=y

# Filesystem tools
BR2_PACKAGE_E2FSPROCS=y
BR2_PACKAGE_E2FSPROCS_MKFS=y
BR2_PACKAGE_E2FSPROCS_RESIZE2FS=y

# Coreutils / tar / gzip for rootfs
BR2_PACKAGE_COREUTILS=y
BR2_PACKAGE_TAR=y
BR2_PACKAGE_GZIP=y
BR2_PACKAGE_XZ=y

#
# Filesystem images
#
BR2_TARGET_ROOTFS_EXT4=y
BR2_TARGET_ROOTFS_EXT4_2T=y
BR2_TARGET_ROOTFS_EXT4_DEFAULT_SIZE=256M
BR2_TARGET_ROOTFS_TAR=y
BR2_TARGET_ROOTFS_TAR_GZIP=y

#
# Board-specific overlay
#
BR2_ROOTFS_OVERLAY="board/mylinux/rootfs-overlay"
